---
import Base from "../layouts/Base.astro";
---

<Base title="Página no encontrada" description="La página que buscás no existe.">
  <section class="container-x max-w-2xl space-y-6 py-28">
    <p class="font-mono text-sm text-signal">404</p>
    <h1 class="text-4xl font-bold sm:text-5xl">No encontramos esta página</h1>
    <p class="text-lg text-ink">Puede que el link haya cambiado con la nueva web. Probá desde acá:</p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary">Ir al inicio</a>
      <a href="/#servicios" class="btn btn-ghost">Ver servicios</a>
      <a href="/contacto" class="btn btn-ghost">Contacto</a>
    </div>
  </section>
</Base>
