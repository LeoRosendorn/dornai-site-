---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-line rounded-2xl border border-line bg-surface">
  {
    items.map((item) => (
      <details class="group px-5 py-4 sm:px-6">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-medium text-paper [&::-webkit-details-marker]:hidden">
          {item.q}
          <span aria-hidden="true" class="text-2xl leading-none text-signal transition-transform group-open:rotate-45">
            +
          </span>
        </summary>
        <p class="mt-3 leading-relaxed text-ink">{item.a}</p>
      </details>
    ))
  }
</div>
